# demo.kbeats: hero demo. Watchlist master-detail with LIVE Kitty-graphics cover
# art, then a typed filter down to a known cover. Covers render as REAL pixels
# here, not the cell-grid halfblock fallback (ROD-464, ported from zigoku ROD-255).
#
# READ-ONLY (safe on the real store): only H (nav), j/k (move), / + type (filter),
# l (detail pane). The runner lints out any mutating key. NB: never `Return` while
# the detail pane is focused (that PLAYS); the one Return here confirms the search
# while the list pane is focused.
#
# Run:  ./docs/media/capture-kitty.sh docs/media/demo.kbeats   → docs/media/demo.gif

sleep 2                 # boot + splash settle (runner seeds landing = history)
key shift+h             # ensure the watchlist two-pane (real store)
sleep 1200ms

# Pre-warm the cover pipeline with a silent scroll pass BEFORE recording, so the
# right-pane cover paints instantly during the take instead of flashing the
# placeholder on each selection change.
key j j j
sleep 400ms
key k k k
sleep 900ms

record demo.gif fps=15 width=960
sleep 700ms

# Browse the watchlist: the right-pane cover updates per selection (now warm).
# Long holds so the painted cover dominates each beat.
key j
sleep 1400ms
key j
sleep 1400ms
key j
sleep 1400ms

# Filter to a known cover; typing animates frame-to-frame.
key slash
sleep 300ms
type frieren
sleep 600ms
key Return
sleep 1500ms

# Enter the detail pane and REST on it: the money frame (cover + kanji chips +
# synopsis). End here; this is the loop point.
key l
sleep 2600ms

endrecord
