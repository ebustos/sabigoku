# discover.kbeats: Discover feed tour (→ discover.gif). The ranked cover wall in
# motion: covers load, the selection sweeps the grid, then the ranking axis
# switches (Trending → Popular) and a whole new wall of covers loads.
#
# READ-ONLY: shift+d nav, hjkl grid moves, 1-4 axis select. No mutating keys (the
# runner lints them). Content is LIVE (AniList feed), so the exact shows vary per
# run. NB: no `/` in Discover (it jumps to Browse search) and no `Return` after
# the first (in the detail zoom it plays).
#
# Run:  ./docs/media/capture-kitty.sh docs/media/discover.kbeats   → docs/media/discover.gif

sleep 2
key shift+d
sleep 7s                  # live feed load (AniList ranking + covers)

record discover.gif fps=15 width=960
sleep 800ms

# sweep the selection across the grid; the highlight moves cover to cover
key l
sleep 650ms
key l
sleep 650ms
key l
sleep 650ms
key j                     # drop into the second cover row
sleep 750ms
key l
sleep 650ms
key k                     # back up to the top row
sleep 900ms

# switch the ranking axis once; a fresh wall of covers loads
key 2                     # Popular
sleep 6s                  # live reload; long hold so the loaded wall is the resting frame

endrecord
